{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset partagé UnPoilTefal/webdropzone — base commune des repos GitHub et GitLab",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Paris)",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts"
  ],
  "semanticCommits": "disabled",
  "commitMessagePrefix": ":arrow_up:",
  "labels": ["renovate"],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "prConcurrentLimit": 6,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "assume-old",
  "packageRules": [
    {
      "description": "Gitmoji :pushpin: pour les pins et digests",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "commitMessagePrefix": ":pushpin:"
    },
    {
      "description": "Majors créées uniquement sur approbation via le Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
